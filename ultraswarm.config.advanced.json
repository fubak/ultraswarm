{
  "notes": [
    "Model IDs below were verified against locally installed CLIs on 2026-06-10:",
    "codex: from ~/.codex/models_cache.json (gpt-5.5, gpt-5.4, gpt-5.4-mini)",
    "opencode: from `opencode models` (xai/*, google/*)",
    "grok: from `grok models` (grok-build, grok-composer-2.5-fast)",
    "gemini/agy/droid lower tiers: best-known IDs, re-verify with `/ultraswarm config` — Phase 0's write probe drops any tier whose model is rejected.",
    "Every models block MUST include a 'simple' tier — it is the fallback when a task's tier is not configured.",
    "intelligence.maxIntelligence (opt-in, default false): flips the ceiling QA slots from Opus to Fable — the always-on security adversarial lens and the expert-escalation review — and allows Fable for expert-tier decomposition. Fable costs ~30% more tokens (tokenizer) plus premium pricing, so it is OFF by default; turn it on only for the most safety-critical work.",
    "pi/pi-local both run the `pi` binary (earendil-works/pi). pi-local routes through an Ollama provider: register an `ollama` provider + the referenced models in ~/.pi/agent/models.json and `ollama pull` them. The qwen3-coder model IDs are defaults — override to match your locally pulled models.",
    "effortFlags (per CLI: codex/droid/pi) maps an effort level to the flag spliced into the {{EFFORT}} slot of that CLI's invocation. Tasks default to effort 'low'; the QA loop escalates effort before model tier.",
    "aliases (opt-in): register your own CLI entries that extend a built-in. pi-qwen-coder below reuses the pi binary with a local Ollama model and a lean harness (--config), and is capped at moderate tier so it never receives expert work. Add the alias name to 'enabled' (or omit 'enabled') to activate it.",
    "agent runs the Cursor CLI (`curl https://cursor.com/install -fsS | bash`). Headless worker runs need CURSOR_API_KEY in workerEnvAllowlist. The host skill installs to ~/.cursor/skills/ultraswarm via scripts/install-cursor-skill.sh.",
    "Token-usage capture: the report's 'Work offloaded' section reads REAL token usage only from a worker's structured output. codex needs `exec --json` and opencode needs `run --format json` in the invocation (already set below) — a custom invocation without those flags will run fine but report 'Token/cost usage: not reported'. Other CLIs (gemini/grok/agy/droid/pi) have no usage parser yet."
  ],
  "enabled": ["codex", "gemini", "grok", "agy", "droid", "opencode", "pi", "pi-local", "agent"],
  "workerEnvAllowlist": ["CURSOR_API_KEY"],
  "intelligence": {
    "promptAnalysis": {
      "enabled": true,
      "complexityThresholds": {
        "simple": 20,
        "moderate": 50,
        "complex": 100,
        "expert": 200
      },
      "taskGranularity": "ultra-fine",
      "maxTaskComplexity": 15
    },
    "maxIntelligence": false,
    "modelRouting": {
      "enabled": true,
      "claudeModels": {
        "promptAnalysis": "sonnet",
        "decomposition": "sonnet",
        "orchestration": "haiku",
        "codeReview": "sonnet",
        "highRiskQA": "opus",
        "finalReport": "haiku"
      }
    }
  },
  "overrides": {
    "codex": {
      "timeoutMs": 900000,
      "effortFlags": {
        "off": "-c model_reasoning_effort=minimal",
        "low": "-c model_reasoning_effort=low",
        "medium": "-c model_reasoning_effort=medium",
        "high": "-c model_reasoning_effort=high",
        "xhigh": "-c model_reasoning_effort=high"
      },
      "models": {
        "simple": {
          "model": "gpt-5.4-mini",
          "invocation": "codex exec --json -s workspace-write --skip-git-repo-check -m gpt-5.4-mini {{EFFORT}}\"$(cat .ultraswarm-prompt.txt)\" </dev/null"
        },
        "moderate": {
          "model": "gpt-5.4",
          "invocation": "codex exec --json -s workspace-write --skip-git-repo-check -m gpt-5.4 {{EFFORT}}\"$(cat .ultraswarm-prompt.txt)\" </dev/null"
        },
        "complex": {
          "model": "gpt-5.5",
          "invocation": "codex exec --json -s workspace-write --skip-git-repo-check -m gpt-5.5 {{EFFORT}}\"$(cat .ultraswarm-prompt.txt)\" </dev/null"
        },
        "expert": {
          "model": "gpt-5.5",
          "invocation": "codex exec --json -s workspace-write --skip-git-repo-check -m gpt-5.5 {{EFFORT}}\"$(cat .ultraswarm-prompt.txt)\" </dev/null"
        }
      }
    },
    "opencode": {
      "models": {
        "simple": {
          "model": "xai/grok-build-0.1",
          "invocation": "opencode run --format json --agent build -m \"xai/grok-build-0.1\" \"$(cat .ultraswarm-prompt.txt)\""
        },
        "moderate": {
          "model": "xai/grok-4.3",
          "invocation": "opencode run --format json --agent build -m \"xai/grok-4.3\" \"$(cat .ultraswarm-prompt.txt)\""
        },
        "complex": {
          "model": "google/gemini-3.1-pro-preview",
          "invocation": "opencode run --format json --agent build -m \"google/gemini-3.1-pro-preview\" \"$(cat .ultraswarm-prompt.txt)\""
        },
        "expert": {
          "model": "xai/grok-4.20-0309-reasoning",
          "invocation": "opencode run --format json --agent build -m \"xai/grok-4.20-0309-reasoning\" \"$(cat .ultraswarm-prompt.txt)\""
        }
      }
    },
    "gemini": {
      "models": {
        "simple": {
          "model": "gemini-2.5-flash",
          "invocation": "gemini --yolo -m gemini-2.5-flash -p \"$(cat .ultraswarm-prompt.txt)\""
        },
        "moderate": {
          "model": "gemini-2.5-pro",
          "invocation": "gemini --yolo -m gemini-2.5-pro -p \"$(cat .ultraswarm-prompt.txt)\""
        },
        "complex": {
          "model": "gemini-2.5-pro",
          "invocation": "gemini --yolo -m gemini-2.5-pro -p \"$(cat .ultraswarm-prompt.txt)\""
        },
        "expert": {
          "model": "gemini-2.5-pro",
          "invocation": "gemini --yolo -m gemini-2.5-pro -p \"$(cat .ultraswarm-prompt.txt)\""
        }
      }
    },
    "grok": {
      "models": {
        "simple": {
          "model": "grok-build",
          "invocation": "grok --always-approve -m grok-build -p \"$(cat .ultraswarm-prompt.txt)\""
        },
        "moderate": {
          "model": "grok-build",
          "invocation": "grok --always-approve -m grok-build -p \"$(cat .ultraswarm-prompt.txt)\""
        },
        "complex": {
          "model": "grok-composer-2.5-fast",
          "invocation": "grok --always-approve -m grok-composer-2.5-fast -p \"$(cat .ultraswarm-prompt.txt)\""
        },
        "expert": {
          "model": "grok-composer-2.5-fast",
          "invocation": "grok --always-approve -m grok-composer-2.5-fast -p \"$(cat .ultraswarm-prompt.txt)\""
        }
      }
    },
    "agy": {
      "models": {
        "simple": {
          "model": "gemini-2.5-flash",
          "invocation": "agy --print-timeout 15m --model gemini-2.5-flash --prompt \"$(cat .ultraswarm-prompt.txt)\""
        },
        "moderate": {
          "model": "gemini-2.5-pro",
          "invocation": "agy --print-timeout 15m --model gemini-2.5-pro --prompt \"$(cat .ultraswarm-prompt.txt)\""
        },
        "complex": {
          "model": "gemini-2.5-pro",
          "invocation": "agy --print-timeout 15m --model gemini-2.5-pro --prompt \"$(cat .ultraswarm-prompt.txt)\""
        },
        "expert": {
          "model": "gemini-2.5-pro",
          "invocation": "agy --print-timeout 15m --model gemini-2.5-pro --prompt \"$(cat .ultraswarm-prompt.txt)\""
        }
      }
    },
    "droid": {
      "models": {
        "simple": {
          "model": "claude-haiku-4-5",
          "invocation": "droid exec -m claude-haiku-4-5 \"$(cat .ultraswarm-prompt.txt)\""
        },
        "moderate": {
          "model": "claude-sonnet-4-6",
          "invocation": "droid exec -m claude-sonnet-4-6 \"$(cat .ultraswarm-prompt.txt)\""
        },
        "complex": {
          "model": "claude-opus-4-8",
          "invocation": "droid exec -m claude-opus-4-8 \"$(cat .ultraswarm-prompt.txt)\""
        },
        "expert": {
          "model": "claude-opus-4-8",
          "invocation": "droid exec -m claude-opus-4-8 -r high \"$(cat .ultraswarm-prompt.txt)\""
        }
      }
    },
    "pi": {
      "models": {
        "simple": {
          "model": "claude-haiku-4-5",
          "invocation": "pi -p --provider anthropic --model claude-haiku-4-5 \"$(cat .ultraswarm-prompt.txt)\""
        },
        "moderate": {
          "model": "claude-sonnet-4-6",
          "invocation": "pi -p --provider anthropic --model claude-sonnet-4-6 \"$(cat .ultraswarm-prompt.txt)\""
        },
        "complex": {
          "model": "claude-opus-4-8",
          "invocation": "pi -p --provider anthropic --model claude-opus-4-8 \"$(cat .ultraswarm-prompt.txt)\""
        },
        "expert": {
          "model": "claude-opus-4-8",
          "invocation": "pi -p --provider anthropic --model claude-opus-4-8 --thinking high \"$(cat .ultraswarm-prompt.txt)\""
        }
      }
    },
    "pi-local": {
      "models": {
        "simple": {
          "model": "qwen3-coder:7b",
          "invocation": "pi -p --provider ollama --model qwen3-coder:7b \"$(cat .ultraswarm-prompt.txt)\""
        },
        "moderate": {
          "model": "qwen3-coder:30b",
          "invocation": "pi -p --provider ollama --model qwen3-coder:30b \"$(cat .ultraswarm-prompt.txt)\""
        },
        "complex": {
          "model": "qwen3-coder:30b",
          "invocation": "pi -p --provider ollama --model qwen3-coder:30b \"$(cat .ultraswarm-prompt.txt)\""
        },
        "expert": {
          "model": "qwen3-coder:30b",
          "invocation": "pi -p --provider ollama --model qwen3-coder:30b \"$(cat .ultraswarm-prompt.txt)\""
        }
      }
    }
  },
  "aliases": {
    "pi-qwen-coder": {
      "extends": "pi",
      "specialty": "local coding, small refactors, unit tests",
      "maxTier": "moderate",
      "models": {
        "simple":   { "model": "qwen3-coder:7b",  "invocation": "pi -p --provider ollama --model qwen3-coder:7b --config ~/.pi/lean.json \"$(cat .ultraswarm-prompt.txt)\"" },
        "moderate": { "model": "qwen3-coder:30b", "invocation": "pi -p --provider ollama --model qwen3-coder:30b \"$(cat .ultraswarm-prompt.txt)\"" }
      }
    }
  },
  "taskStrategies": {
    "decomposition": {
      "strategy": "ultra-granular",
      "maxComplexityPerTask": 15,
      "preferredTaskSize": "atomic",
      "dependencies": "minimal",
      "parallelization": "aggressive"
    },
    "quality": {
      "codeReview": {
        "allTasks": true,
        "multipleReviewers": "complex",
        "adversarialTesting": "high-risk"
      },
      "testing": {
        "unitTests": "mandatory",
        "integrationTests": "moderate",
        "e2eTests": "complex"
      }
    }
  }
}

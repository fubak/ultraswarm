{
  "notes": [
    "Model IDs below were verified against locally installed CLIs on 2026-06-10:",
    "codex: from ~/.codex/models_cache.json (gpt-5.5, gpt-5.4, gpt-5.4-mini)",
    "opencode: from `opencode models` (xai/*, google/*)",
    "grok: from `grok models` (grok-build, grok-composer-2.5-fast)",
    "gemini/agy/droid lower tiers: best-known IDs, re-verify with `/ultraswarm config` — Phase 0's write probe drops any tier whose model is rejected.",
    "Every models block MUST include a 'simple' tier — it is the fallback when a task's tier is not configured.",
    "intelligence.maxIntelligence (opt-in, default false): flips the ceiling QA slots from Opus to Fable — the always-on security adversarial lens and the expert-escalation review — and allows Fable for expert-tier decomposition. Fable costs ~30% more tokens (tokenizer) plus premium pricing, so it is OFF by default; turn it on only for the most safety-critical work."
  ],
  "enabled": ["codex", "gemini", "grok", "agy", "droid", "opencode"],
  "intelligence": {
    "promptAnalysis": {
      "enabled": true,
      "complexityThresholds": {
        "simple": 20,
        "moderate": 50,
        "complex": 100,
        "expert": 200
      },
      "taskGranularity": "ultra-fine",
      "maxTaskComplexity": 15
    },
    "maxIntelligence": false,
    "modelRouting": {
      "enabled": true,
      "claudeModels": {
        "promptAnalysis": "sonnet",
        "decomposition": "sonnet",
        "orchestration": "haiku",
        "codeReview": "sonnet",
        "highRiskQA": "opus",
        "finalReport": "haiku"
      }
    }
  },
  "overrides": {
    "codex": {
      "timeoutMs": 900000,
      "models": {
        "simple": {
          "model": "gpt-5.4-mini",
          "invocation": "codex exec -s workspace-write --skip-git-repo-check -m gpt-5.4-mini \"$(cat .ultraswarm-prompt.txt)\" </dev/null"
        },
        "moderate": {
          "model": "gpt-5.4",
          "invocation": "codex exec -s workspace-write --skip-git-repo-check -m gpt-5.4 \"$(cat .ultraswarm-prompt.txt)\" </dev/null"
        },
        "complex": {
          "model": "gpt-5.5",
          "invocation": "codex exec -s workspace-write --skip-git-repo-check -m gpt-5.5 \"$(cat .ultraswarm-prompt.txt)\" </dev/null"
        },
        "expert": {
          "model": "gpt-5.5",
          "invocation": "codex exec -s workspace-write --skip-git-repo-check -m gpt-5.5 -c model_reasoning_effort=high \"$(cat .ultraswarm-prompt.txt)\" </dev/null"
        }
      }
    },
    "opencode": {
      "models": {
        "simple": {
          "model": "xai/grok-build-0.1",
          "invocation": "opencode run --agent build -m \"xai/grok-build-0.1\" \"$(cat .ultraswarm-prompt.txt)\""
        },
        "moderate": {
          "model": "xai/grok-4.3",
          "invocation": "opencode run --agent build -m \"xai/grok-4.3\" \"$(cat .ultraswarm-prompt.txt)\""
        },
        "complex": {
          "model": "google/gemini-3.1-pro-preview",
          "invocation": "opencode run --agent build -m \"google/gemini-3.1-pro-preview\" \"$(cat .ultraswarm-prompt.txt)\""
        },
        "expert": {
          "model": "xai/grok-4.20-0309-reasoning",
          "invocation": "opencode run --agent build -m \"xai/grok-4.20-0309-reasoning\" \"$(cat .ultraswarm-prompt.txt)\""
        }
      }
    },
    "gemini": {
      "models": {
        "simple": {
          "model": "gemini-2.5-flash",
          "invocation": "gemini --yolo -m gemini-2.5-flash -p \"$(cat .ultraswarm-prompt.txt)\""
        },
        "moderate": {
          "model": "gemini-2.5-pro",
          "invocation": "gemini --yolo -m gemini-2.5-pro -p \"$(cat .ultraswarm-prompt.txt)\""
        },
        "complex": {
          "model": "gemini-2.5-pro",
          "invocation": "gemini --yolo -m gemini-2.5-pro -p \"$(cat .ultraswarm-prompt.txt)\""
        },
        "expert": {
          "model": "gemini-2.5-pro",
          "invocation": "gemini --yolo -m gemini-2.5-pro -p \"$(cat .ultraswarm-prompt.txt)\""
        }
      }
    },
    "grok": {
      "models": {
        "simple": {
          "model": "grok-build",
          "invocation": "grok --always-approve -m grok-build -p \"$(cat .ultraswarm-prompt.txt)\""
        },
        "moderate": {
          "model": "grok-build",
          "invocation": "grok --always-approve -m grok-build -p \"$(cat .ultraswarm-prompt.txt)\""
        },
        "complex": {
          "model": "grok-composer-2.5-fast",
          "invocation": "grok --always-approve -m grok-composer-2.5-fast -p \"$(cat .ultraswarm-prompt.txt)\""
        },
        "expert": {
          "model": "grok-composer-2.5-fast",
          "invocation": "grok --always-approve -m grok-composer-2.5-fast -p \"$(cat .ultraswarm-prompt.txt)\""
        }
      }
    },
    "agy": {
      "models": {
        "simple": {
          "model": "gemini-2.5-flash",
          "invocation": "agy --print-timeout 15m --model gemini-2.5-flash --prompt \"$(cat .ultraswarm-prompt.txt)\""
        },
        "moderate": {
          "model": "gemini-2.5-pro",
          "invocation": "agy --print-timeout 15m --model gemini-2.5-pro --prompt \"$(cat .ultraswarm-prompt.txt)\""
        },
        "complex": {
          "model": "gemini-2.5-pro",
          "invocation": "agy --print-timeout 15m --model gemini-2.5-pro --prompt \"$(cat .ultraswarm-prompt.txt)\""
        },
        "expert": {
          "model": "gemini-2.5-pro",
          "invocation": "agy --print-timeout 15m --model gemini-2.5-pro --prompt \"$(cat .ultraswarm-prompt.txt)\""
        }
      }
    },
    "droid": {
      "models": {
        "simple": {
          "model": "claude-haiku-4-5",
          "invocation": "droid exec -m claude-haiku-4-5 \"$(cat .ultraswarm-prompt.txt)\""
        },
        "moderate": {
          "model": "claude-sonnet-4-6",
          "invocation": "droid exec -m claude-sonnet-4-6 \"$(cat .ultraswarm-prompt.txt)\""
        },
        "complex": {
          "model": "claude-opus-4-8",
          "invocation": "droid exec -m claude-opus-4-8 \"$(cat .ultraswarm-prompt.txt)\""
        },
        "expert": {
          "model": "claude-opus-4-8",
          "invocation": "droid exec -m claude-opus-4-8 -r high \"$(cat .ultraswarm-prompt.txt)\""
        }
      }
    }
  },
  "taskStrategies": {
    "decomposition": {
      "strategy": "ultra-granular",
      "maxComplexityPerTask": 15,
      "preferredTaskSize": "atomic",
      "dependencies": "minimal",
      "parallelization": "aggressive"
    },
    "quality": {
      "codeReview": {
        "allTasks": true,
        "multipleReviewers": "complex",
        "adversarialTesting": "high-risk"
      },
      "testing": {
        "unitTests": "mandatory",
        "integrationTests": "moderate",
        "e2eTests": "complex"
      }
    }
  }
}
